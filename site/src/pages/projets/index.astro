---
import Base from '../../layouts/Base.astro';
import CarteProjet from '../../components/CarteProjet.astro';
import { projetsTries } from '../../lib/projets';

const projets = await projetsTries();
---

<Base titre="Projets">
  <h1>Projets</h1>
  <div class="grille">
    {projets.map((projet) => <CarteProjet projet={projet} />)}
  </div>
</Base>

<style>
  .grille { display: grid; gap: 1rem; }
</style>
