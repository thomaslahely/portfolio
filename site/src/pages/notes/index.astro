---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes')).sort((a, b) => a.data.titre.localeCompare(b.data.titre));
---

<Base titre="Notes">
  <h1>Notes</h1>
  <p>Notes techniques écrites en administrant mon serveur et en travaillant sur mes projets.</p>
  <ul>
    {notes.map((note) => (
      <li><a href={`/notes/${note.id}`}>{note.data.titre.replace(/^Note\s+—\s+/, '')}</a></li>
    ))}
  </ul>
</Base>
